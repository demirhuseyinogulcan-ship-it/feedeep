# ─────────────────────────────────────────────────────────────
# feedeep — Environment Variables
# Bu dosyayı .env.local olarak kopyalayıp değerleri doldurun.
# Vercel'de: Settings → Environment Variables altına ekleyin.
# ─────────────────────────────────────────────────────────────

# Google Analytics 4 — Measurement ID (G-XXXXXXXXXX)
# GA4 → Admin → Data Streams → Web → Measurement ID
NEXT_PUBLIC_GA_ID=

# Site URL — Üretimde domain değişikliği için
NEXT_PUBLIC_SITE_URL=https://feedeep.com

# Google Search Console — HTML meta tag doğrulama kodu
# GSC → Settings → Ownership verification → HTML tag
# Sadece content değerini yapıştırın (tırnak olmadan)
NEXT_PUBLIC_GSC_ID=

# Supabase — Dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Deploy sonrası otomatik index pipeline (GitHub Action + Search Console)
GSC_SITE_URL=https://feedeep.com/
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=

# Vercel Webhook → GitHub Dispatch
INDEXING_WEBHOOK_SECRET=
GITHUB_INDEXING_TOKEN=
GITHUB_REPO_OWNER=
GITHUB_REPO_NAME=

# Upstash Redis — Rate Limiting (Serverless)
# https://console.upstash.com → Redis → Create Database
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
