# feedeep environment variables
# Copy this file to .env.local and fill in what you need.
# Every value is optional: without them the site runs read-only.

# Site
NEXT_PUBLIC_SITE_URL=https://feedeep.com

# Google Analytics 4 measurement ID (G-XXXXXXXXXX)
NEXT_PUBLIC_GA_ID=
# Google Search Console HTML tag verification code (content value only)
NEXT_PUBLIC_GSC_ID=

# Supabase: Dashboard > Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Upstash Redis for rate limiting: console.upstash.com > Redis
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# true lets requests through when Redis is unreachable
FEEDEEP_SECURITY_FAIL_OPEN=false

# Resend newsletter: resend.com > API Keys and Audiences
RESEND_API_KEY=
RESEND_AUDIENCE_ID=

# Web Push (VAPID). Generate once with:
# node -e "console.log(require('web-push').generateVAPIDKeys())"
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Protects the push send endpoint. Any long random string.
PUSH_SEND_SECRET=

# Post-deploy indexing (GitHub Action + Search Console)
GSC_SITE_URL=https://feedeep.com/
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
INDEXING_WEBHOOK_SECRET=
GITHUB_INDEXING_TOKEN=
GITHUB_REPO_OWNER=
GITHUB_REPO_NAME=
