# feedeep — Environment Variables
# Bu dosyayı .env.local olarak kopyalayın ve değerleri doldurun

# Google Analytics 4 Measurement ID
NEXT_PUBLIC_GA_ID=G-CBLXWVX00M

# Site URL — Üretimde domain değişikliği için
NEXT_PUBLIC_SITE_URL=https://feedeep.com

# Google Search Console Verification
NEXT_PUBLIC_GSC_ID=

# Supabase — Dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGci...

# Deploy sonrası otomatik index pipeline (GitHub Action + Search Console)
GSC_SITE_URL=https://feedeep.com/
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=

# Vercel Webhook → GitHub Dispatch
INDEXING_WEBHOOK_SECRET=
GITHUB_INDEXING_TOKEN=
GITHUB_REPO_OWNER=
GITHUB_REPO_NAME=

# Upstash Redis — Rate Limiting (Serverless)
# https://console.upstash.com → Redis → Create Database
UPSTASH_REDIS_REST_URL=https://xxxxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=AXxxxx...
FEEDEEP_SECURITY_FAIL_OPEN=false

# Resend — Newsletter Email Servisi
# https://resend.com → API Keys → Create API Key
RESEND_API_KEY=re_xxxxxxxxxxxx

# Resend Audience ID — newsletter contact listesi
# https://resend.com → Audiences → Create Audience → ID'yi kopyala
RESEND_AUDIENCE_ID=

# Web Push (VAPID) — Bildirim altyapısı
# Anahtar üretimi (bir kez): node -e "const wp=require('web-push'); console.log(wp.generateVAPIDKeys())"
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Push bildirim gönderme API'sini korur
# Rastgele güvenli string: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PUSH_SEND_SECRET=

# Supabase service_role key — sadece server-side API route'larında kullan
# Dashboard → Settings → API → service_role (ASLA client-side'a verme)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGci...
